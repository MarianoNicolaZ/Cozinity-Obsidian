{
  "id": "notion-minimal",
  "label": "Notion Minimal",
  "description": "Dashboard editorial estilo Notion: blanco o negro, aire amplio, bordes casi invisibles y foco en el contenido.",
  "themePreset": "sage",
  "previewSwatches": [
    "#ffffff",
    "#171717",
    "#f4f4f2",
    "#2f7d59"
  ],
  "assets": {
    "notebookCover": {
      "src": ""
    },
    "panelMain": {
      "src": ""
    },
    "panelSide": {
      "src": ""
    },
    "headerFrame": {
      "src": ""
    },
    "chipFrame": {
      "src": ""
    },
    "buttonFrame": {
      "src": ""
    },
    "iconButtonFrame": {
      "src": ""
    },
    "petHelper": "../../assets/nest-helper.gif",
    "decorations": {
      "flower": "../../assets/deco-flower.svg",
      "plant": "../../assets/deco-plant.svg",
      "butterfly": "../../assets/deco-butterfly.svg",
      "bear": "../../assets/deco-bear.svg",
      "sparkles": "../../assets/deco-sparkles.svg"
    }
  },
  "tokens": {
