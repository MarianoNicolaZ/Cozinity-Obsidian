{
  "id": "minimal-os",
  "label": "Minimal OS",
  "description": "Negro mate, lineas sutiles y ventanas limpias al estilo Notion.",
  "themePreset": "twilight",
  "previewSwatches": [
    "#090a0b",
    "#1b1d20",
    "#d7dbe0",
    "#8f969f"
  ],
  "tokens": {
    "shared": {
      "--cozy-font-family-override": "var(--font-interface), Inter, ui-sans-serif, system-ui, sans-serif",
      "--cozy-font-display-override": "var(--font-interface), Inter, ui-sans-serif, system-ui, sans-serif",
      "--cozy-radius-panel": "8px",
      "--cozy-radius-button": "6px",
      "--cozy-theme-frame-shadow": "none",
      "--notebook-cover": "#1b1d20",
      "--notebook-cover-2": "#111214",
      "--notebook-page": "#e8ebee",
      "--cozy-notebook-cover-blend-mode": "normal",
      "--cozy-notebook-cover-opacity": "1",
      "--cozy-notebook-cover-filter": "none"
    },
    "light": {
      "--cozy-bg-top": "#090a0b",
      "--cozy-bg-bottom": "#090a0b",
      "--cozy-frame-top": "#0d0f11",
      "--cozy-frame-bottom": "#0b0c0e",
      "--cozy-frame-border": "rgba(224, 229, 235, 0.10)",
      "--cozy-panel-top": "#111315",
      "--cozy-panel-bottom": "#0f1113",
      "--cozy-panel-border": "rgba(224, 229, 235, 0.11)",
      "--cozy-panel-shadow": "rgba(0, 0, 0, 0.22)",
      "--cozy-text": "#e8ebee",
      "--cozy-text-muted": "#949ba4",
      "--cozy-chip-bg": "rgba(232, 235, 238, 0.05)",
      "--cozy-chip-border": "rgba(232, 235, 238, 0.11)",
      "--cozy-button-bg": "#171a1d",
      "--cozy-button-border": "rgba(232, 235, 238, 0.12)",
      "--cozy-button-hover": "#1d2024",
      "--cozy-accent": "#d7dbe0",
      "--cozy-accent-2": "#9da5ae",
      "--cozy-accent-3": "#747c85",
      "--cozy-calendar-muted": "rgba(232, 235, 238, 0.06)",
      "--cozy-calendar-today": "rgba(215, 219, 224, 0.12)",
      "--cozy-calendar-journal": "rgba(157, 165, 174, 0.12)",
      "--cozy-group-1": "#4d545c",
      "--cozy-group-2": "#66707a",
      "--cozy-group-3": "#858d96",
      "--cozy-pet-fur": "#9da5ae",
      "--cozy-pet-fur-dark": "#5b626a",
      "--cozy-pet-belly": "#dfe3e7",
      "--cozy-pet-eye": "#090a0b",
      "--cozy-pet-nose": "#aeb5bd",
      "--cozy-pet-paw": "#7d858e",
      "--cozy-sparkle": "#d7dbe0",
      "--cozy-on-accent": "#141414",
      "--cozy-link-text": "#d7dbe0",
      "--cozy-color-scheme": "dark"
    },
    "dark": {
      "--cozy-bg-top": "#090a0b",
      "--cozy-bg-bottom": "#090a0b",
      "--cozy-frame-top": "#0d0f11",
      "--cozy-frame-bottom": "#0b0c0e",
      "--cozy-frame-border": "rgba(224, 229, 235, 0.10)",
      "--cozy-panel-top": "#111315",
      "--cozy-panel-bottom": "#0f1113",
      "--cozy-panel-border": "rgba(224, 229, 235, 0.11)",
      "--cozy-panel-shadow": "rgba(0, 0, 0, 0.22)",
      "--cozy-text": "#e8ebee",
      "--cozy-text-muted": "#949ba4",
      "--cozy-chip-bg": "rgba(232, 235, 238, 0.05)",
      "--cozy-chip-border": "rgba(232, 235, 238, 0.11)",
      "--cozy-button-bg": "#171a1d",
      "--cozy-button-border": "rgba(232, 235, 238, 0.12)",
      "--cozy-button-hover": "#1d2024",
      "--cozy-accent": "#d7dbe0",
      "--cozy-accent-2": "#9da5ae",
      "--cozy-accent-3": "#747c85",
      "--cozy-calendar-muted": "rgba(232, 235, 238, 0.06)",
      "--cozy-calendar-today": "rgba(215, 219, 224, 0.12)",
      "--cozy-calendar-journal": "rgba(157, 165, 174, 0.12)",
      "--cozy-group-1": "#4d545c",
      "--cozy-group-2": "#66707a",
      "--cozy-group-3": "#858d96",
      "--cozy-pet-fur": "#9da5ae",
      "--cozy-pet-fur-dark": "#5b626a",
      "--cozy-pet-belly": "#dfe3e7",
      "--cozy-pet-eye": "#090a0b",
      "--cozy-pet-nose": "#aeb5bd",
      "--cozy-pet-paw": "#7d858e",
      "--cozy-sparkle": "#d7dbe0",
      "--cozy-on-accent": "#141414",
      "--cozy-link-text": "#d7dbe0",
      "--cozy-color-scheme": "dark"
    }
  }
}
